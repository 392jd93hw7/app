<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">#090A12</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#090A12</item>
        <item name="android:postSplashScreenTheme">@style/NormalTheme</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
